\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Observable-specific Mpemba effect. Distance to equilibrium $|O(t) - O_\mathrm  {eq}|$ for cold (blue) and hot (red) initial conditions, averaged over 10 seeds. (a)~Basin occupancy $p_\mathrm  {left}$ shows a clear crossing. (b)~Energy shows no crossing. (c)~Position variance shows no crossing. Parameters: $b = 1.0$, $T = 0.2$, $N = 5000$.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:core}{{1}{5}{Observable-specific Mpemba effect. Distance to equilibrium $|O(t) - O_\mathrm {eq}|$ for cold (blue) and hot (red) initial conditions, averaged over 10 seeds. (a)~Basin occupancy $p_\mathrm {left}$ shows a clear crossing. (b)~Energy shows no crossing. (c)~Position variance shows no crossing. Parameters: $b = 1.0$, $T = 0.2$, $N = 5000$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Phase diagram and spectral prediction. (a)~Mean \% of simulation time with hot closer to equilibrium ($p_\mathrm  {left}$), across 9~barrier heights and 8~temperatures. (b)~$\log _{10}(\tau _1/\tau _2)$ from Fokker--Planck spectrum. (c)~Overlay with spectral contours at $\tau _1/\tau _2 = 5, 10, 50$.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:phase}{{2}{5}{Phase diagram and spectral prediction. (a)~Mean \% of simulation time with hot closer to equilibrium ($p_\mathrm {left}$), across 9~barrier heights and 8~temperatures. (b)~$\log _{10}(\tau _1/\tau _2)$ from Fokker--Planck spectrum. (c)~Overlay with spectral contours at $\tau _1/\tau _2 = 5, 10, 50$}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mechanism controls. (a)~Unbalanced cold: strong crossing. (b)~Balanced cold: effect eliminated (28\%). (c)~Single-well: no effect (47\%).}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:controls}{{3}{5}{Mechanism controls. (a)~Unbalanced cold: strong crossing. (b)~Balanced cold: effect eliminated (28\%). (c)~Single-well: no effect (47\%)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Spectral analysis. Top: Fokker--Planck eigenmodes at three parameter points. Bottom left: Kramers formula vs.\ numerical $\lambda _1$ (94\% within factor~2). Bottom right: $\tau _1/\tau _2$ vs.\ numerical \% crossed.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:spectral}{{4}{6}{Spectral analysis. Top: Fokker--Planck eigenmodes at three parameter points. Bottom left: Kramers formula vs.\ numerical $\lambda _1$ (94\% within factor~2). Bottom right: $\tau _1/\tau _2$ vs.\ numerical \% crossed}{figure.4}{}}
